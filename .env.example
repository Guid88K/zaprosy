# Секрет для підпису сесій (обов'язково в production). Згенерувати: openssl rand -base64 32
AUTH_SECRET=

# SQLite-файл за замовчуванням. Для Turso: libsql://... + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/zaprosy.db
DATABASE_AUTH_TOKEN=

# Публічна адреса сайту (для посилань у сповіщеннях). Якщо порожньо, береться з заголовків запиту.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Посилання на донат: Buy Me a Coffee (https://buymeacoffee.com/ваш_нік) або monobank Банка (https://send.monobank.ua/jar/...).
# Якщо порожньо, кнопка «Підтримати проєкт» не показується.
NEXT_PUBLIC_SUPPORT_URL=

# Сповіщення в Telegram: створи бота через @BotFather і встав токен
TELEGRAM_BOT_TOKEN=

# Сповіщення на email через SMTP (якщо SMTP_HOST порожній, листи не надсилаються)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Запроси <no-reply@example.com>"
